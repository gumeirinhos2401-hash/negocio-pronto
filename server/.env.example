# Copy to .env (never commit .env) or set these in the hosting dashboard.

# Required in production. Without it the server uses an embedded Postgres in server/data.
DATABASE_URL=

# Required in production: the public address of the app, used in email links and the origin check.
APP_URL=

# Optional: extra allowed origins, comma separated. Defaults to APP_URL.
ALLOWED_ORIGINS=

# Email through Resend. Without both, development prints the email to the console
# and production refuses to send.
RESEND_API_KEY=
MAIL_FROM=

# Behind a reverse proxy, the number of proxy hops (usually 1) or the proxy IP/CIDR list,
# e.g. 10.0.0.0/8. Never "true": that lets any client choose its own address.
TRUST_PROXY=false

NODE_ENV=development
HOST=127.0.0.1
PORT=3001
